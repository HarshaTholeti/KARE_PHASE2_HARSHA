//program to find the prime numbers within a range
import java.util.*;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int range=sc.nextInt();
        for(int n=0;n<=range;n++){
            if(n<=1){
                continue;
            }
            boolean prime=true;
            for(int i=2;i<=n/2;i++){
                if(n%i==0){
                    prime=false;
                    break;
                }
            }
            if(prime){
                System.out.print(n+" ");
            }
        }
    }
}

