//program to find the multiplivation of a table without using '*' operator
import java.util.*;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the n value:");
        int n = sc.nextInt();
        int mul = 0;
        for(int i=1;i<=10;i++){
            mul+=n;
            System.out.println(n+" * "+i+" = "+mul);
        }
    }
}

