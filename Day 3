//program to get starting and ending range from user and sum of element in given range.
import java.util.*;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the starting range:");
        int s= sc.nextInt();
        System.out.print("Enter the ending range:");
        int n = sc.nextInt();
        int sum = 0;
        for(int i=s;i<=n;i++){
            sum = sum + i;
        }
        System.out.println("The sum of the numbers between "+s+"and "+n+"is"+sum);
    }
}

Output:
Enter the starting range:1
Enter the ending range:5
The sum of the numbers between 1and 5 is 15
