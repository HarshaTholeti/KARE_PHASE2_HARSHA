//Multi level inheritance
class GrandFather{
    void gen1(){
        System.out.println("Money");
    }
}
class Father extends GrandFather{
    void gen21(){
        System.out.println("Gold");
    }
}
class Mother extends Father{
    void gen22(){
        System.out.println("silver");
    }
}
class Son extends Father{
    void gen3(){
        System.out.println("Bronze");
    }
}
class Main{
    public static void main(String args[]){
        System.out.println("Son class :");
        Son s=new Son();
        s.gen3();
        s.gen21();
        s.gen1();
        System.out.println("Mother class :");
        Mother m=new Mother();
        m.gen22();
        m.gen21();
    }
}


// write a java program to check a specific number is perfect square or not by using function with no argument no return type.
import java.util.*;
class Main{
    void ps(){
        Scanner sc = new Scanner (System.in);
        int n=sc.nextInt();
        int flag=0;
        for(int i=1;i<n;i++){
            if(i*i==n){
                flag=1;
                System.out.println("Perfect Square");
                break;
            }
        }
        if(flag==0){
            System.out.println("Not a perfect square");
        }
    }
    public static void main(String args[]){
        Main s=new Main();
        s.ps();
    }
}

Output:
9
Perfect Square


// write a java program to check a specific number is power of 2 or not by using function with argument no return type.
import java.util.*;
class Main{
    void powerOftwo(int n){
        while(n%2==0){
            n=n/2;
        }
        if(n==1){
            System.out.println("Power Of Two");
        } else {
            System.out.println("Not a Power Of Two");
        }
    }
    public static void main(String args[]){
        Main s=new Main();
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        s.powerOftwo(n);
    }
}

Output:
4
Power Of Two
