//program to find the average of elements which are even and divisible by 3 and print the average with two decimal points.
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        float sum=0;
        int count=0;
        int arr[] = new int[n];
        for(int i=0;i<n;i++){
            arr[i] = sc.nextInt();
            if(arr[i]%2 == 0 && arr[i]%3 ==0){
                sum+=arr[i];
                count++;
            }
        }
        System.out.printf("the avg is %.2f",sum/count);
    }
}

Output:
5
2 4 6 18 24
the avg is 16.00


//program to find the power of a given number without using inbuilt method 
import java.util.*;
public class Main{
    public int Power(int a, int b){
        int pow=1;
        int i=0;
        for(i=0;i<b;i++){
            pow*=a;
        }
        return pow;
    }
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n =sc.nextInt();
        int m = sc.nextInt();
        Main obj = new Main();
        int res = obj.Power(n,m);
        System.out.print("the power of "+ n + " power " + m + " is " + res);
    }
    }

