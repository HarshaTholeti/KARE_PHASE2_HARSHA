//program to print the 2D array.
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner  sc=new Scanner(System.in);
		System.out.print("Enter the row size:");
		int m=sc.nextInt();
		System.out.print("Enter the column size:");
		int n=sc.nextInt();
		int[][] arr=new int[m][n];
		for(int i=0;i<n;i++){
		    for(int j=0;j<n;j++){
		        arr[i][j]=sc.nextInt();
		    }
		}
		System.out.print("The elements are:");
		for(int i=0;i<n;i++){
		    for(int j=0;j<n;j++){
		        System.out.print(arr[i][j]+" ");
		    }
		    System.out.println();
		}
	}
}

Output:
Enter the row size:3
Enter the column size:3
1 2 3
4 5 6
7 8 9
The elements are:
1 2 3 
4 5 6 
7 8 9 


//program to print the sum of elements.
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner  sc=new Scanner(System.in);
		System.out.print("Enter the row size:");
		int m=sc.nextInt();
		System.out.print("Enter the column size:");
		int n=sc.nextInt();
		int[][] arr=new int[m][n];
		for(int i=0;i<n;i++){
		    for(int j=0;j<n;j++){
		        arr[i][j]=sc.nextInt();
		    }
		}
		int sum=0;
		for(int i=0;i<n;i++){
		    for(int j=0;j<n;j++){
		        sum+=arr[i][j];
		    }
		    System.out.println();
		}
		System.out.println("The sum of elements is:"+sum);
	}
}

Output:
Enter the row size:3
Enter the column size:2
1 2 3
4 5 6
The sum of elements is:10
