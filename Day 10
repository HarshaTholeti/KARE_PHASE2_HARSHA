HI i am Harsha
14


// program to find no. of words in a string.
import java.util.*;
public class Main{
    public static void main(String args[]){
        Scanner sc=new Scanner(System.in);
        String s=sc.nextLine();
        int words=1;
        for(char ch:s.toCharArray()){
            if(ch==' '){
                words++;
            }
        }
        System.out.print(words);
    }
}

