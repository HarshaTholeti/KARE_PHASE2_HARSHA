//program to print the diagonal elements in a matrix.
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner  sc=new Scanner(System.in);
		System.out.print("Enter the row and column size:");
		int m=sc.nextInt();
		int[][] arr=new int[m][m];
		for(int i=0;i<m;i++){
		    for(int j=0;j<m;j++){
		        arr[i][j]=sc.nextInt();
		    }
		}
		for(int i=0;i<m;i++){
		    System.out.println(arr[i][i]+" ");
		}
		for(int i=0;i<m;i++){
		    System.out.print(arr[i][m-1-i]+" ");
		}
	}
}

Output:
Enter the row and column size:3
1 2 3
4 5 6
7 8 9
1 5 9 3 5 7 


//program to transpose a matrix,
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner  sc=new Scanner(System.in);
		System.out.print("Enter the row and column size:");
		int m=sc.nextInt();
		int n=sc.nextInt();
		int[][] arr=new int[m][n];
		int[][] transpose=new int[n][m];
		for(int i=0;i<m;i++){
		    for(int j=0;j<n;j++){
		        arr[i][j]=sc.nextInt();
		    }
		}
		for(int i=0;i<m;i++){
		    for(int j=0;j<n;j++){
		        transpose[j][i]=arr[i][j];
		    }
		}
		System.out.println("Matrix before transpose:");
		for(int i=0;i<m;i++){
		    for(int j=0;j<n;j++){
		        System.out.print(arr[i][j]+" ");
		    }
		    System.out.println();
		}
		System.out.println("Matrix after transpose:");
		for(int i=0;i<n;i++){
		    for(int j=0;j<m;j++){
		        System.out.print(transpose[i][j]+" ");
		    }
		    System.out.println();
		}
	}
}

Output:
Enter the row and column size:2
3
1 2 3
4 5 6
Matrix before transpose:
1 2 3 
4 5 6 
Matrix after transpose:
1 4 
2 5 
3 6 


//program to print length of a string without using inbuilt function.
import java.util.*;
public class Main{
    public static void main(String args[]){
        Scanner sc=new Scanner(System.in);
        String s=sc.nextLine();
        int c=0;
        for(char ch:s.toCharArray()){
            c++;
        }
        System.out.print(c);
    }
}

