		Scanner sc = new Scanner(System.in);
		System.out.print("Enter the size of array:");
		int min=Integer.MIN_VALUE;
		int n= sc.nextInt();
		int[] arr=new int[n];
		for(int i=0;i<n;i++){
		    arr[i]=sc.nextInt();
		}
