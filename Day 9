//program to find the single number in a array.
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		System.out.print("Enter the size of array:");
		int n=sc.nextInt();
		int[] nums=new int[n];
		for(int i=0;i<n;i++){
		    nums[i]=sc.nextInt();
		}
		int m=0;
		for(int i=0;i<n;i++){
		    m=m^nums[i];
		}
		System.out.println(m);
	}
}

