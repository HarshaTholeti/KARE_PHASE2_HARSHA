// program to replace an element at a particular index in array.
import java.util.*;
public class Main{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter the size of arr:");
		int n=sc.nextInt();
		int oddcount=0;
		int evencount=0;
		int[] arr = new int[n];
		for(int i=0;i<n;i++){
		    arr[i]=sc.nextInt();
		}
		System.out.println("Before Replacing:");
		for(int i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
		System.out.println("Enter the index value to replacing:");
		int index=sc.nextInt();
		System.out.println("Enter the value to replace");
		int value = sc.nextInt();
		arr[index]=value;
		System.out.println("After Replacing:");
		for(int i=0;i<n;i++){
		    System.out.print(arr[i]+" ");
		}
	}
}

Output:
Enter the size of arr:5
1 2 3 4 5 
Before Replacing:
1 2 3 4 5 Enter the index value to replacing:
2
Enter the value to replace
6
After Replacing:
1 2 6 4 5 


//program to find a element present in array or not.
import java.util.*;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int flag=0;
        System.out.print("Enter the size of array:");
        int n=sc.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int target = sc.nextInt();
        for(int i=0;i<n;i++){
            if(arr[i]==target){
                flag=1;
                System.out.println("Target present");
                break;
            }
        }
        if(flag==0){
            System.out.println("Target is not present");
        }
    }
}

Output:
Enter the size of array:5
1 2 3 4 5 
5
Target present


